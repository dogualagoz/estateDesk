NODE_ENV=production
POSTGRES_USER=estatedesk
POSTGRES_PASSWORD=__STRONG_SECRET__
POSTGRES_DB=estatedesk
DATABASE_URL=postgresql://estatedesk:__STRONG_SECRET__@db:5432/estatedesk?schema=public
JWT_SECRET=__STRONG_SECRET__
JWT_EXPIRES_IN=12h
SEED_ADMIN_EMAIL=admin@estatedesk.local
SEED_ADMIN_PASSWORD=__STRONG_SECRET__
CORS_ORIGIN=https://estatedesk.example.com
FRONTEND_URL=https://estatedesk.example.com

# Platform sahibi (süper admin) — /admin API + /yonetim paneli
SEED_SUPERADMIN_EMAIL=__OWNER_EMAIL__
SEED_SUPERADMIN_PASSWORD=__STRONG_SECRET__

# Log saklama süreleri (gün) — opsiyonel
# REQUEST_LOG_RETENTION_DAYS=30
# AUDIT_LOG_RETENTION_DAYS=365

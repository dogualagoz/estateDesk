generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN      // Ofis yöneticisi — yetkileri kendi ofisiyle sınırlıdır
  AGENT      // Danışman
  SUPERADMIN // Platform sahibi — ofisten bağımsız (officeId null), /admin uçlarına erişir
}

enum PropertyType {
  APARTMENT
  VILLA
  LAND
  HOTEL
  SHOP
  OFFICE
}

enum ListingType {
  SALE
  RENT
}

enum PortfolioVisibility {
  PUBLIC
  HIDDEN
}

enum DemandStatus {
  ACTIVE
  CLOSED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DemandShareMode {
  ALL_MATCHES
  PINNED
}

enum DemandShareStatus {
  ACTIVE
  REVOKED
}

enum PasswordResetStatus {
  PENDING
  USED
  EXPIRED
}

enum IntakeLinkStatus {
  ACTIVE
  REVOKED
}

enum IntakeSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Office {
  id        String   @id @default(cuid())
  name      String
  ownerId   String   @unique
  owner     User     @relation("OfficeOwner", fields: [ownerId], references: [id])
  // Beta geri bildirim kanalı — süperadmin ofis bazında açar/kapatır
  feedbackEnabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    User[]      @relation("OfficeMembers")
  portfolios    Portfolio[]
  demands       Demand[]
  invites       Invite[]
  demandMatches DemandMatch[]
  demandShares  DemandShare[]
  feedbackThread FeedbackThread?
  intakeLinks   PortfolioIntakeLink[]
}

model Invite {
  id              String       @id @default(cuid())
  email           String?
  // Token DB default'u ile değil, serviste crypto.randomBytes ile üretilir
  // (cuid tahmin edilebilir; bkz. common/token.util.ts)
  token           String       @unique
  status          InviteStatus @default(PENDING)
  officeId        String
  office          Office       @relation(fields: [officeId], references: [id])
  invitedById     String
  invitedBy       User         @relation("InviteCreatedBy", fields: [invitedById], references: [id])
  expiresAt       DateTime
  acceptedAt      DateTime?
  acceptedByEmail String?
  createdAt       DateTime     @default(now())

  @@index([officeId, status])
  @@index([token])
}

model PasswordReset {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  token     String              @unique
  status    PasswordResetStatus @default(PENDING)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([token])
  @@index([userId, status])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(AGENT)
  isActive     Boolean  @default(true)
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  officeId    String?
  office      Office?  @relation("OfficeMembers", fields: [officeId], references: [id])
  ownedOffice Office?  @relation("OfficeOwner")
  sentInvites Invite[] @relation("InviteCreatedBy")

  portfolios      Portfolio[]
  demands         Demand[]
  demandMatches   DemandMatch[]
  demandShares    DemandShare[]
  passwordResets  PasswordReset[]
  feedbackMessages FeedbackMessage[] @relation("FeedbackSender")
  intakeLinks         PortfolioIntakeLink[] @relation("IntakeLinkCreatedBy")
  reviewedSubmissions PortfolioSubmission[] @relation("IntakeReviewedBy")
}

model Portfolio {
  id           String              @id @default(cuid())
  type         PropertyType
  listingType  ListingType         @default(SALE)
  title        String?
  city         String
  district     String
  neighborhood String?
  areaSqm      Int
  roomCount    String
  price        Decimal             @db.Decimal(14, 2)
  features     String[]            @default([])
  images       String[]            @default([])
  visibility   PortfolioVisibility @default(PUBLIC)
  note         String?
  ownerName    String
  ownerNameVisible Boolean         @default(false)
  ownerPhone   String
  isShareable  Boolean             @default(true)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  demandMatches DemandMatch[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([officeId, type, city, district, visibility])
  @@index([officeId, deletedAt])
  @@index([deletedAt])
}

model Demand {
  id              String         @id @default(cuid())
  types           PropertyType[] @default([])
  listingType     ListingType    @default(SALE)
  regions         String[]       @default([])
  city            String?
  district        String?
  neighborhood    String?
  districts       String[]       @default([])
  neighborhoods   String[]       @default([])
  minBudget       Decimal?       @db.Decimal(14, 2)
  maxBudget       Decimal?       @db.Decimal(14, 2)
  roomPreferences String[]       @default([])
  minArea         Int?
  maxArea         Int?
  featurePrefs    String[]       @default([])
  mustHaveFeatures String[]      @default([])
  bonusFeatures   String[]       @default([])
  note            String?
  customerName    String
  customerPhone   String
  status          DemandStatus   @default(ACTIVE)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  demandMatches DemandMatch[]
  demandShares  DemandShare[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([deletedAt])
  @@index([officeId, status])
  @@index([officeId, deletedAt])
  @@index([listingType, city, status])
}

model DemandMatch {
  id          String    @id @default(cuid())
  demandId    String
  demand      Demand    @relation(fields: [demandId], references: [id])
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id])
  officeId    String
  office      Office    @relation(fields: [officeId], references: [id])
  pinnedById  String
  pinnedBy    User      @relation(fields: [pinnedById], references: [id])
  pinnedAt    DateTime  @default(now())

  @@unique([demandId, portfolioId])
  @@index([demandId])
  @@index([portfolioId])
  @@index([officeId])
}

model DemandShare {
  id          String            @id @default(cuid())
  // Token serviste crypto.randomBytes ile üretilir (bkz. common/token.util.ts)
  token       String            @unique
  demandId    String
  demand      Demand            @relation(fields: [demandId], references: [id])
  officeId    String
  office      Office            @relation(fields: [officeId], references: [id])
  mode        DemandShareMode
  note        String?
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id])
  status      DemandShareStatus @default(ACTIVE)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime          @default(now())

  @@index([demandId])
  @@index([token])
}

// ── Portföy toplama linki (harici mülk sahibi başvurusu) ──────────────────
// Danışman süreli/iptal edilebilir link üretir; mülk sahibi kayıt olmadan
// başvuru gönderir. Başvuru PENDING bekler; danışman onaylayınca mevcut
// portfolio.create yoluyla gerçek Portfolio oluşur (Portfolio'ya status
// EKLENMEZ — mevcut deletedAt:null sorguları hiç etkilenmesin diye).

model PortfolioIntakeLink {
  id          String           @id @default(cuid())
  // Token serviste crypto.randomBytes ile üretilir (bkz. common/token.util.ts)
  token       String           @unique
  officeId    String
  office      Office           @relation(fields: [officeId], references: [id])
  createdById String
  createdBy   User             @relation("IntakeLinkCreatedBy", fields: [createdById], references: [id])
  label       String? // örn. "Mehmet Bey — eczacı"
  status      IntakeLinkStatus @default(ACTIVE)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  submissions PortfolioSubmission[]

  @@index([officeId, status])
  @@index([token])
}

model PortfolioSubmission {
  id             String              @id @default(cuid())
  linkId         String
  link           PortfolioIntakeLink @relation(fields: [linkId], references: [id])
  officeId       String // ofis-kapsamlı sorgular için denormalize
  submitterName  String
  submitterPhone String

  type         PropertyType
  listingType  ListingType @default(SALE)
  title        String?
  city         String
  district     String
  neighborhood String?
  areaSqm      Int
  roomCount    String
  price        Decimal     @db.Decimal(14, 2)
  features     String[]    @default([])
  description  String? // onayda Portfolio.note olur
  images       String[]    @default([]) // /uploads/intake/:id/*.webp

  kvkkAcceptedAt DateTime
  status         IntakeSubmissionStatus @default(PENDING)
  reviewedById   String?
  reviewedBy     User?                  @relation("IntakeReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  rejectReason   String?
  portfolioId    String?                @unique
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([officeId, status, createdAt])
  @@index([linkId])
}

// ── Geri bildirim mesajlaşması (beta) ─────────────────────────────────────
// Ofis başına tek sohbet: ofis kullanıcıları ↔ platform sahibi (SUPERADMIN).
// Okunmadı sayacı lastReadAt damgalarıyla hesaplanır (mesaj başına flag yok).

model FeedbackThread {
  id               String    @id @default(cuid())
  officeId         String    @unique
  office           Office    @relation(fields: [officeId], references: [id])
  officeLastReadAt DateTime?
  adminLastReadAt  DateTime?
  lastMessageAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  messages FeedbackMessage[]
}

model FeedbackMessage {
  id        String         @id @default(cuid())
  threadId  String
  thread    FeedbackThread @relation(fields: [threadId], references: [id])
  senderId  String
  sender    User           @relation("FeedbackSender", fields: [senderId], references: [id])
  fromAdmin Boolean        @default(false)
  body      String
  createdAt DateTime       @default(now())

  @@index([threadId, createdAt])
}

// ── Denetim ve gözlemlenebilirlik (admin paneli) ──────────────────────────
// Bilinçli olarak FK yok: kullanıcı/ofis silinse bile log kaydı kalmalıdır.

// Güvenlik ve iş olayları denetim kaydı — kim, neyi, ne zaman yaptı.
// `action` enum değil String: yeni olay türü eklemek migration gerektirmez;
// geçerli değerler src/audit/audit-actions.ts sabitlerinde toplanır.
model AuditLog {
  id         String   @id @default(cuid())
  action     String
  userId     String?
  officeId   String?
  targetType String? // 'user' | 'office' | 'invite' | 'demand' | ...
  targetId   String?
  ip         String?
  userAgent  String?
  metadata   Json?
  requestId  String? // RequestLog / HTTP yanıtlarındaki x-request-id ile korelasyon
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([userId, createdAt])
  @@index([officeId, createdAt])
}

// HTTP istek günlüğü — stdout'a ek olarak admin panelde sorgulanabilir kalıcı kayıt.
// Retention: varsayılan 30 gün (log-retention.service.ts cron'u temizler).
model RequestLog {
  id         String   @id @default(cuid())
  requestId  String
  method     String
  path       String
  statusCode Int
  durationMs Int
  userId     String?
  officeId   String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([statusCode, createdAt])
  @@index([userId, createdAt])
}

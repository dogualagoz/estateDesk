NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://estatedesk:estatedesk@db:5432/estatedesk?schema=public
JWT_SECRET=generate-a-long-random-secret
JWT_EXPIRES_IN=12h
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-strong-password
SEED_ADMIN_NAME=Admin

# Platform sahibi (süper admin) — tanımlıysa seed'de oluşturulur; /yonetim paneline erişir
SEED_SUPERADMIN_EMAIL=owner@example.com
SEED_SUPERADMIN_PASSWORD=change-me-strong-password
SEED_SUPERADMIN_NAME=Platform Yöneticisi

CORS_ORIGIN=http://localhost:5173

FRONTEND_URL=http://localhost:5173

# Yükleme dizini (varsayılan: <çalışma dizini>/uploads; Docker'da /app/uploads)
# UPLOADS_DIR=/app/uploads

# E-posta gönderimi (Nodemailer SMTP)
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@example.com

# Geri bildirim mesajlarının bildirim maili alıcısı (platform sahibi)
# FEEDBACK_NOTIFY_EMAIL=owner@example.com
